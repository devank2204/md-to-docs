      "type": "CodeBlock",
      "language": "python",
      "value": "def fibonacci(n: int) -> list[int]:\n    \"\"\"Generate fibonacci sequence up to n terms.\"\"\"\n    if n <= 0:\n        return []\n    sequence = [0, 1]\n    for _ in range(2, n):\n        sequence.append(sequence[-1] + sequence[-2])\n    return sequence[:n]",
